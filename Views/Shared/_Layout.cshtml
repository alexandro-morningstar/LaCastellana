<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta lang="es-MX">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="@Html.AntiForgeryToken()">
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline';">
    <title>@ViewBag.PageName - La Castellana</title>

    @* =============== Head Inyectable (link, script, meta...) =============== *@
    @RenderSection("Head", required: false)

    @* =============== Estilos Globales =============== *@
    <link rel="stylesheet" href="~/css/_Layout.css">
</head>
<body>
    <nav></nav>
    <main></main>
        <!-- ================= SECCIÓN: BODY INYECCIONABLE (Navegación) ================= -->
    @* Aquí inyectamos la navegación global o scripts comunes en el body *@
    @RenderSection("Navigation", required: false)

    <!-- ================= CONTENEDOR PRINCIPAL (RenderBody) ================= -->
    @* Aquí se inyecta el contenido de cada página hija (Index.cshtml, etc.) *@
    @RenderBody()

    <!-- ================= SECCIÓN: FOOTER / SCRIPTS INYECCIONABLE ================= -->
    @* Aquí inyectamos scripts al final del body (ideal para analytics o scripts dinámicos) *@
    @RenderSection("Scripts", required: false)

    <!-- Scripts Globales (JS del Layout) -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Scripts de Seguridad (ej: Anti-CSRF en JS si es necesario) -->
    <script src="~/js/security.js" asp-append-version="true"></script>
</body>
</html>